// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model alunos {
  id             Int            @id @default(autoincrement())
  nome           String
  idade          Int?
  dataNascimento DateTime?
  email          String
  cpf            String
  senha          String?
  plano          String
  ultimoAcesso   DateTime?
  updatedAt      DateTime       @updatedAt
  createdAt      DateTime       @default(now())
  treinos        treino[]
  presencas      presenca[]
  funcionarioId  Int? 
  funcionario    Funcionarios?  @relation(fields: [funcionarioId], references: [id])
}

model Funcionarios {
  id             Int      @id @default(autoincrement())
  nome           String
  adm            Boolean  @default(false)
  email          String
  senha          String
  idade          Int?
  dataNascimento DateTime?
  cpf            String
  clt            String
  turno          String
  cargo          String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
  alunos         alunos[]
}

model treino {
  id          Int      @id @default(autoincrement())
  nome        String
  descricao   String
  dificuldade String
  duracao     Int
  tipoTreino  String
  alunoId     Int
  aluno       alunos   @relation(fields: [alunoId], references: [id])
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())
}

model receita {
  id             Int      @id @default(autoincrement())
  pagamento      String
  dataPagamento  DateTime
  valorPagamento String
  status         String
  formaPagamento String
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model despesa {
  id             Int      @id @default(autoincrement())
  descricao      String
  valor          Float
  categoria      String   // LUZ, AGUA, INTERNET, MANUTENCAO, OUTROS
  dataVencimento DateTime
  dataPagamento  DateTime?
  status         String   // PAGO, PENDENTE
  updatedAt      DateTime @updatedAt
  createdAt      DateTime @default(now())
}

model presenca {
  id        Int      @id @default(autoincrement())
  alunoId   Int
  aluno     alunos   @relation(fields: [alunoId], references: [id])
  dataHora  DateTime @default(now())
}

